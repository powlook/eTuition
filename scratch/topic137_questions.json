  {
    "id": 133983,
    "title": "Right Triangle Hypotenuse #1",
    "text": "In a right triangle ABC with right angle at C, side a = 9 cm and side b = 12 cm. Find the length of hypotenuse c.",
    "img": "/images/g8_t137_q1.svg",
    "options": [
      "14 cm",
      "15 cm",
      "21 cm",
      "16 cm"
    ],
    "answer": "15 cm",
    "steps": [
      "**Step 1: Apply Pythagorean theorem**",
      "$$c = \\sqrt{9^2 + 12^2} = \\sqrt{81 + 144}$$",
      "**Step 2: Evaluate square root**",
      "$$c = \\sqrt{225} = 15\\text{ cm}$$",
      "**Final Verified Answer:** \\(15 cm\\)"
    ],
    "formula": "c = \\sqrt{a^2 + b^2}"
  },
  {
    "id": 133984,
    "title": "Missing Leg Calculation #2",
    "text": "Find the missing leg length of a right triangle whose hypotenuse measures 25 cm and one leg measures 7 cm.",
    "img": "/images/g8_t137_q2.svg",
    "options": [
      "20 cm",
      "18 cm",
      "26 cm",
      "24 cm"
    ],
    "answer": "24 cm",
    "steps": [
      "**Step 1: Solve for missing leg**",
      "$$a = \\sqrt{25^2 - 7^2} = \\sqrt{625 - 49}$$",
      "**Step 2: Evaluate square root**",
      "$$a = \\sqrt{576} = 24\\text{ cm}$$",
      "**Final Verified Answer:** \\(24 cm\\)"
    ],
    "formula": "a = \\sqrt{c^2 - b^2}"
  },
  {
    "id": 133985,
    "title": "Triangle Classification (8,15,17) #3",
    "text": "Classify a triangle with side lengths 8 cm, 15 cm, and 17 cm as acute, right, or obtuse using the converse of the Pythagorean Theorem.",
    "img": "/images/g8_t137_q3.svg",
    "options": [
      "Right Triangle (17² = 8² + 15²)",
      "Equilateral Triangle",
      "Acute Triangle",
      "Obtuse Triangle"
    ],
    "answer": "Right Triangle (17² = 8² + 15²)",
    "steps": [
      "**Step 1: Square the longest side**",
      "$$c^2 = 17^2 = 289$$",
      "**Step 2: Sum the squares of shorter sides**",
      "$$a^2 + b^2 = 8^2 + 15^2 = 64 + 225 = 289$$",
      "**Step 3: Compare values**",
      "$$289 = 289 \\implies \\text{Right Triangle}$$",
      "**Final Verified Answer:** \\(Right Triangle (17² = 8² + 15²)\\)"
    ],
    "formula": "c^2 = a^2 + b^2 \\implies \\text{Right Triangle}"
  },
