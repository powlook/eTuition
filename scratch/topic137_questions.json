    "title": "Triangle Classification (7,10,12) #4",
    "text": "Determine whether a triangle with side lengths 7 cm, 10 cm, and 12 cm is a right triangle, acute triangle, or obtuse triangle.",
    "img": "/images/g8_t137_q4.svg",
    "options": [
      "Scalene Right Triangle",
      "Acute Triangle (12² < 7² + 10²)",
      "Right Triangle",
      "Obtuse Triangle"
    ],
    "answer": "Acute Triangle (12² < 7² + 10²)",
    "steps": [
      "**Step 1: Square longest side**",
      "$$c^2 = 12^2 = 144$$",
      "**Step 2: Sum squares of shorter sides**",
      "$$a^2 + b^2 = 7^2 + 10^2 = 49 + 100 = 149$$",
      "**Step 3: Compare values**",
      "$$144 < 149 \\implies \\text{Acute Triangle}$$",
      "**Final Verified Answer:** \\(Acute Triangle (12² < 7² + 10²)\\)"
    ],
    "formula": "c^2 < a^2 + b^2 \\implies \\text{Acute Triangle}"
  },
